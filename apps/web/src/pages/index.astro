---
import { env } from 'cloudflare:workers';
import { createDb, getSummary, isSiteInitialized } from '@trustfall/db';
import {
  ComponentGroupSection,
  IncidentCard,
  MaintenanceCard,
  OverallStatusBanner,
  Stack,
  Text,
} from '@trustfall/design';
import type { ComponentStatus } from '@trustfall/shared';
import UninitializedNotice from '../components/UninitializedNotice.astro';
import Site from '../layouts/Site.astro';

const db = createDb(env.DB);
const initialized = await isSiteInitialized(db);

if (initialized) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=120');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

let summary;
try {
  summary = await getSummary(db);
} catch {
  summary = {
    overallStatus: 'OPERATIONAL' as const,
    siteName: 'TrustFall',
    siteDescription: '',
    componentGroups: [],
    ungroupedComponents: [],
    activeIncidents: [],
    activeMaintenances: [],
  };
}
---

{
  initialized ? (
    <Site
      title={summary.siteName}
      description={summary.siteDescription}
      siteName={summary.siteName}
      current="overview"
    >
        <Stack gap={5}>
          <OverallStatusBanner
            status={summary.overallStatus}
            siteName={summary.siteName}
            description={summary.siteDescription}
          />
          {
            summary.componentGroups.length === 0 && summary.ungroupedComponents.length === 0 ? (
              <Text tone="muted">No components have been published yet.</Text>
            ) : null
          }
          {
            summary.componentGroups.map((group) => (
              <ComponentGroupSection
                displayName={group.displayName}
                description={group.description}
                components={group.components.map((component) => ({
                  id: component.id,
                  displayName: component.displayName,
                  description: component.description,
                  status: component.status as ComponentStatus,
                }))}
              />
            ))
          }
          {
            summary.ungroupedComponents.length > 0 ? (
              <ComponentGroupSection
                displayName="Other"
                components={summary.ungroupedComponents.map((component) => ({
                  id: component.id,
                  displayName: component.displayName,
                  description: component.description,
                  status: component.status as ComponentStatus,
                }))}
              />
            ) : null
          }
          {
            summary.activeMaintenances.length > 0 ? (
              <Stack gap={3}>
                <Text as="h2" tone="title">
                  Scheduled maintenance
                </Text>
                {summary.activeMaintenances.map((maintenance) => (
                  <MaintenanceCard
                    maintenance={{
                      id: maintenance.id,
                      title: maintenance.title,
                      status: maintenance.status,
                      windowStart: maintenance.windowStart,
                      windowEnd: maintenance.windowEnd,
                      startTime: maintenance.startTime,
                      recurrence: maintenance.recurrence ?? null,
                      timeZone: maintenance.timeZone,
                      affectedComponents: maintenance.components,
                      updates: maintenance.updates,
                    }}
                  />
                ))}
              </Stack>
            ) : null
          }
          {
            summary.activeIncidents.length > 0 ? (
              <Stack gap={3}>
                <Text as="h2" tone="title">
                  Active incidents
                </Text>
                {summary.activeIncidents.map((incident) => (
                  <IncidentCard
                    incident={{
                      id: incident.id,
                      title: incident.title,
                      status: incident.status,
                      impact: incident.impact,
                      startTime: incident.startTime,
                      resolveTime: incident.resolveTime,
                      updates: incident.updates,
                      href: `/incidents/${incident.id}`,
                    }}
                  />
                ))}
              </Stack>
            ) : null
          }
        </Stack>
    </Site>
  ) : (
    <UninitializedNotice />
  )
}
