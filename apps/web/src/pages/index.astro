---
import { env } from 'cloudflare:workers';
import {
  createDb,
  getSummary,
  isSiteInitialized,
  listIncidents,
  listMaintenances,
} from '@trustfall/db';
import {
  ComponentGroupSection,
  IncidentCard,
  MaintenanceCard,
  OverallStatusBanner,
  type PublicIncident,
  type PublicMaintenance,
  SitePanel,
  Stack,
  Text,
} from '@trustfall/design';
import type { ComponentStatus } from '@trustfall/shared';
import UninitializedNotice from '../components/UninitializedNotice.astro';
import Site from '../layouts/Site.astro';

const db = createDb(env.DB);
const initialized = await isSiteInitialized(db);

if (initialized) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=120');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

type Summary = Awaited<ReturnType<typeof getSummary>>;
type Incident = Summary['activeIncidents'][number];
type Maintenance = Summary['activeMaintenances'][number];

const RECENT_LIMIT = 6;

let summary: Summary;
let recentIncidents: Incident[] = [];
let recentMaintenances: Maintenance[] = [];
try {
  [summary, recentIncidents, recentMaintenances] = await Promise.all([
    getSummary(db),
    listIncidents(db, { state: 'RESOLVED', pageSize: RECENT_LIMIT }).then((page) => page.incidents),
    listMaintenances(db, { state: 'PAST', pageSize: RECENT_LIMIT }).then(
      (page) => page.maintenances,
    ),
  ]);
} catch {
  summary = {
    overallStatus: 'OPERATIONAL' as const,
    siteName: 'TrustFall',
    siteDescription: '',
    componentGroups: [],
    ungroupedComponents: [],
    activeIncidents: [],
    activeMaintenances: [],
  };
}

const toIncident = (incident: Incident): PublicIncident => ({
  id: incident.id,
  title: incident.title,
  status: incident.status,
  impact: incident.impact,
  startTime: incident.startTime,
  resolveTime: incident.resolveTime,
  updates: incident.updates,
  href: `/incidents/${incident.id}`,
});

const toMaintenance = (maintenance: Maintenance): PublicMaintenance => ({
  id: maintenance.id,
  title: maintenance.title,
  status: maintenance.status,
  windowStart: maintenance.windowStart,
  windowEnd: maintenance.windowEnd,
  startTime: maintenance.startTime,
  recurrence: maintenance.recurrence ?? null,
  timeZone: maintenance.timeZone,
  affectedComponents: maintenance.components,
  updates: maintenance.updates,
});

// Under way now, versus still to open.
const underWay = summary.activeMaintenances.filter((item) => item.status === 'IN_PROGRESS');
const scheduled = summary.activeMaintenances.filter((item) => item.status === 'SCHEDULED');

// What happened lately, incidents and maintenance together, latest first.
type Recent =
  | { kind: 'incident'; at: number; incident: PublicIncident }
  | { kind: 'maintenance'; at: number; maintenance: PublicMaintenance };
const recent: Recent[] = [
  ...recentIncidents.map(
    (incident): Recent => ({
      kind: 'incident',
      at: incident.resolveTime ?? incident.startTime,
      incident: toIncident(incident),
    }),
  ),
  ...recentMaintenances.map(
    (maintenance): Recent => ({
      kind: 'maintenance',
      at: maintenance.windowEnd,
      maintenance: toMaintenance(maintenance),
    }),
  ),
]
  .sort((a, b) => b.at - a.at)
  .slice(0, RECENT_LIMIT);

const hasComponents =
  summary.componentGroups.length > 0 || summary.ungroupedComponents.length > 0;
const toComponents = (components: Summary['ungroupedComponents']) =>
  components.map((component) => ({
    id: component.id,
    displayName: component.displayName,
    description: component.description,
    status: component.status as ComponentStatus,
  }));
---

{
  initialized ? (
    <Site
      title={summary.siteName}
      description={summary.siteDescription}
      siteName={summary.siteName}
      current="overview"
    >
      <SitePanel>
        <Stack gap={5}>
          <OverallStatusBanner
            status={summary.overallStatus}
            siteName={summary.siteName}
            description={summary.siteDescription}
          />
          {hasComponents ? null : <Text tone="muted">No components have been published yet.</Text>}
          {summary.componentGroups.map((group) => (
            <ComponentGroupSection
              displayName={group.displayName}
              description={group.description}
              components={toComponents(group.components)}
            />
          ))}
          {summary.ungroupedComponents.length > 0 ? (
            <ComponentGroupSection
              displayName="Other"
              components={toComponents(summary.ungroupedComponents)}
            />
          ) : null}
        </Stack>
      </SitePanel>

      <SitePanel>
        <Stack gap={3}>
          <Text as="h2" tone="title">
            Active incidents and maintenance
          </Text>
          {summary.activeIncidents.length === 0 && underWay.length === 0 ? (
            <Text tone="muted">Nothing is under way.</Text>
          ) : null}
          {summary.activeIncidents.map((incident) => (
            <IncidentCard incident={toIncident(incident)} />
          ))}
          {underWay.map((maintenance) => (
            <MaintenanceCard maintenance={toMaintenance(maintenance)} />
          ))}
        </Stack>
      </SitePanel>

      <SitePanel>
        <Stack gap={3}>
          <Text as="h2" tone="title">
            Recent incidents and maintenance
          </Text>
          {recent.length === 0 ? (
            <Text tone="muted">Nothing has happened lately.</Text>
          ) : (
            recent.map((item) =>
              item.kind === 'incident' ? (
                <IncidentCard incident={item.incident} />
              ) : (
                <MaintenanceCard maintenance={item.maintenance} />
              ),
            )
          )}
        </Stack>
      </SitePanel>

      <SitePanel>
        <Stack gap={3}>
          <Text as="h2" tone="title">
            Scheduled maintenance
          </Text>
          {scheduled.length === 0 ? (
            <Text tone="muted">No maintenance is scheduled.</Text>
          ) : (
            scheduled.map((maintenance) => (
              <MaintenanceCard maintenance={toMaintenance(maintenance)} />
            ))
          )}
        </Stack>
      </SitePanel>
    </Site>
  ) : (
    <UninitializedNotice />
  )
}
