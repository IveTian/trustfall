---
import { env } from 'cloudflare:workers';
import {
  createDb,
  getSetting,
  isSiteInitialized,
  listActiveMaintenances,
  listMaintenances,
} from '@trustfall/db';
import { MaintenanceCard, SiteGroup, SiteHeading, SitePanel, Text } from '@trustfall/design';
import UninitializedNotice from '../components/UninitializedNotice.astro';
import Site from '../layouts/Site.astro';
import { toMaintenance } from '../public-cards.ts';

const db = createDb(env.DB);
const initialized = await isSiteInitialized(db);

if (initialized) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=120');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// What is ahead — under way first, then the next windows soonest first —
// and what is over, newest first. The Scheduled section only appears when
// there is something in it.
type Maintenances = Awaited<ReturnType<typeof listMaintenances>>['maintenances'];
let scheduled: Maintenances = [];
let past: Maintenances = [];
let siteName = 'TrustFall';
if (initialized) {
  try {
    [scheduled, past] = await Promise.all([
      listActiveMaintenances(db),
      listMaintenances(db, { state: 'PAST', pageSize: 50 }).then((page) => page.maintenances),
    ]);
  } catch {
    scheduled = [];
    past = [];
  }
  try {
    siteName = (await getSetting(db, 'siteName')) ?? 'TrustFall';
  } catch {
    // The default name is enough to render the page.
  }
}
---

{
  initialized ? (
    <Site title={`Maintenance · ${siteName}`} siteName={siteName} current="maintenance">
      <SiteHeading as="h1">Maintenance</SiteHeading>
      {scheduled.length > 0 ? (
        <>
          <SiteHeading tone="group">Scheduled</SiteHeading>
          <SiteGroup>
            {scheduled.map((maintenance) => (
              <SitePanel as="article" minRows={2.5} step={0.5}>
                <MaintenanceCard
                  client:load
                  surface="plain"
                  locale="en"
                  maintenance={toMaintenance(maintenance)}
                />
              </SitePanel>
            ))}
          </SiteGroup>
          <SiteHeading tone="group">Past</SiteHeading>
        </>
      ) : null}
      <SiteGroup>
        {past.length === 0 ? (
          <SitePanel density="row">
            <Text tone="muted">
              {scheduled.length > 0
                ? 'No maintenance has been completed yet.'
                : 'No maintenance windows have been published.'}
            </Text>
          </SitePanel>
        ) : (
          past.map((maintenance) => (
            <SitePanel as="article" minRows={2.5} step={0.5}>
              <MaintenanceCard
                client:load
                surface="plain"
                locale="en"
                maintenance={toMaintenance(maintenance)}
              />
            </SitePanel>
          ))
        )}
      </SiteGroup>
    </Site>
  ) : (
    <UninitializedNotice />
  )
}
