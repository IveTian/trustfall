---
import { env } from 'cloudflare:workers';
import { createDb, isSiteInitialized, listIncidents } from '@trustfall/db';
import { IncidentCard, SitePanel, Stack, Text } from '@trustfall/design';
import UninitializedNotice from '../../components/UninitializedNotice.astro';
import Site from '../../layouts/Site.astro';

const db = createDb(env.DB);
const initialized = await isSiteInitialized(db);

if (initialized) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=120');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

let incidents: Awaited<ReturnType<typeof listIncidents>>['incidents'] = [];
let siteName = 'TrustFall';
if (initialized) {
  try {
    const listed = await listIncidents(db, { pageSize: 50 });
    incidents = listed.incidents;
    const { getSetting } = await import('@trustfall/db');
    siteName = (await getSetting(db, 'siteName')) ?? 'TrustFall';
  } catch {
    incidents = [];
  }
}
---

{
  initialized ? (
    <Site title={`Incident history · ${siteName}`} siteName={siteName} current="history">
      <SitePanel>
        <Stack gap={4}>
          <Text as="h1" tone="display">Incident history</Text>
          {
            incidents.length === 0 ? (
              <Text tone="muted">No incidents have been published.</Text>
            ) : (
              incidents.map((incident) => (
                <IncidentCard
                  incident={{
                    id: incident.id,
                    title: incident.title,
                    status: incident.status,
                    impact: incident.impact,
                    startTime: incident.startTime,
                    resolveTime: incident.resolveTime,
                    updates: incident.updates,
                    href: `/incidents/${incident.id}`,
                  }}
                />
              ))
            )
          }
        </Stack>
      </SitePanel>
    </Site>
  ) : (
    <UninitializedNotice />
  )
}
